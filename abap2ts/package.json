{
  "name": "abap2ts",
  "version": "0.1.0",
  "description": "MCP Server: traverse SAP ABAP objects and generate TypeScript from templates",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "docx": "^9.6.1",
    "handlebars": "^4.7.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
